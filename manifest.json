{
  "manifest_version": 3,
  "name": "Sellify AI - E-Commerce Assistant",
  "version": "1.0.0",
  "description": "AI-powered product listing optimizer, review analyzer, and keyword generator for e-commerce sellers.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.ca/*",
    "https://*.ebay.com/*",
    "https://*.etsy.com/*",
    "https://*.myshopify.com/*",
    "https://*.aliexpress.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Sellify AI"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.ebay.com/*",
        "https://*.etsy.com/*",
        "https://*.aliexpress.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "popup/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
